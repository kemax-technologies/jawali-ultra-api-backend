# ══════════════════════════════════════════════════════════
# Jawali Ultra v17 — Backend Environment (.env.example)
#
# ❌ لا ترفع .env إلى git
# ✅ انسخ هذا الملف إلى .env وعبّئ القيم الحقيقية
# ✅ .htaccess يمنع الوصول من المتصفح للملف .env
# ══════════════════════════════════════════════════════════

# ── JWT Secret (إلزامي) ──────────────────────────────────
# يجب أن تكون طويلة (>=64 حرفاً) وعشوائية تماماً
# توليد: openssl rand -hex 64
# ⚠️ لا تغيّرها بعد النشر — ستخرج كل المستخدمين
JWT_SECRET=

# ── Database (Supabase — PostgreSQL) ────────────────────
# ✅ تم ترحيل قاعدة البيانات من MySQL/XAMPP إلى Supabase (PostgreSQL مُدارة سحابياً)
#
# كيف تحصل على هذه القيم من Supabase:
# 1) أنشئ مشروعاً جديداً على https://supabase.com
# 2) من لوحة التحكم: Project Settings → Database → Connection Parameters
#    (يُفضّل استخدام "Connection Pooling" / Transaction pooler على المنفذ 6543
#     للاتصالات القصيرة من PHP، أو 5432 للاتصال المباشر)
# 3) نفّذ ملفات الـ schema بالترتيب من تبويب SQL Editor في Supabase:
#      - jawali_xampp/jawali_db_postgres.sql
#      - jawali_xampp/jawali_db_admin_patch_postgres.sql
#      - jawali_db_social_recovery_patch_postgres.sql
#
# مثال على القيم (Host يختلف حسب مشروعك):
#   DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
#   DB_PORT=5432
#   DB_NAME=postgres
#   DB_USER=postgres
#   DB_PASS=<كلمة مرور قاعدة البيانات من Supabase>
DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=
# ✅ Supabase يتطلب SSL دوماً — اتركها "require" (القيمة الافتراضية في _db.php أيضاً require)
DB_SSLMODE=require

# ── Google OAuth (اختياري — لتفعيل تسجيل الدخول بـ Google) ──────────────────
# Web Client ID من Google Cloud Console → Credentials
GOOGLE_CLIENT_ID=

# ── Apple OAuth (اختياري — iOS) ─────────────────────────────────
# Bundle ID تطبيقك بالضبط
APPLE_CLIENT_ID=

# ── SMS Gateway (اختياري — للـ OTP عبر الهاتف، Twilio) ──────────────────────
# SMS_PROVIDER=twilio
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=Jawali

# ── Email Gateway (اختياري — SendGrid لاستعادة كلمة المرور عبر SMS/قنوات
#    غير Supabase؛ قناة البريد الإلكتروني تُستخدم عبر Supabase Auth تلقائياً
#    ولا تحتاج هذه المتغيرات) ────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@jawali.app
SENDGRID_FROM_NAME=Jawali Ultra

# ── Supabase Auth (اختياري — لإرسال OTP بريد حقيقي عبر SMTP المجاني المدمج
#    في Supabase Auth، بدون أي مزوّد بريد خارجي مدفوع) ──────────────────────
# ⚠️ ملاحظة: نفس مشروع Supabase المستخدَم في DB_HOST أعلاه — يُستخدم هنا فقط
#    الـ Project URL والـ anon key العامّين (لا صلة بكلمة مرور القاعدة)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── وضع التطوير ──────────────────────────────────────
# 1 = يعيد رموز OTP في الاستجابة (للاختبار فقط)
# ✅ تأكد أنه 0 في الإنتاج
JAWALI_DEV_MODE=0

# ── لوحة المطوّر (Dev Panel) — إلزامي لتفعيل dev_*.php ───────────
# DEV_PANEL_PASSWORD_HASH: نتيجة password_hash() لكلمة مرور لوحة المطوّر
# توليد: php -r "echo password_hash('YOUR_STRONG_PASSWORD', PASSWORD_DEFAULT);"
DEV_PANEL_PASSWORD_HASH=
# DEV_JWT_SECRET: سر JWT منفصل تماماً عن JWT_SECRET الخاص بالمستخدمين العاديين
# (طبقة عزل إضافية بين توكنات المستخدمين وتوكن لوحة المطوّر — إن تُرك فارغاً
# سيُستخدم افتراضياً JWT_SECRET + '::dev-panel' كإجراء احتياطي فقط، ويُفضّل
# دائماً تعيينه صراحةً في بيئة الإنتاج)
# توليد: openssl rand -hex 64
DEV_JWT_SECRET=
